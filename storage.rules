rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Businesses Images: Public read, Authenticated write with strict constraints
    match /businesses/{businessId}/{allPaths=**} {
      // Anyone can read images
      allow read: if true;

      // Only authenticated admins can upload images (Max 5MB each, valid image type)
      allow write: if request.auth != null &&
                    request.resource.size < 5 * 1024 * 1024 &&
                    request.resource.contentType.matches('image/.*');
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
